# Plantilla de Variables de Entorno - Scrapio RAG System
# Copiar este archivo a .env.local y llenar los valores correspondientes.

# Google Gemini API Key (Obtener en https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Pinecone API Configuration (Obtener en https://app.pinecone.io)
PINECONE_API_KEY=tu_pinecone_api_key_aqui
PINECONE_INDEX_NAME=scrapio

# Proveedor de IA (gemini | openai)
AI_PROVIDER=gemini

# OpenAI API Key (Opcional - para pruebas futuras)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Secreto para autenticación de la API Headless (/api/v1/query)
SCRAPIO_API_KEY=un_token_secreto_personalizado

# GitHub REST API Token para disparar ingestas desde la web a GitHub Actions
GITHUB_TOKEN=ghp_tu_github_personal_access_token
GITHUB_REPO_OWNER=seo-w
GITHUB_REPO_NAME=scrapio

# ScraperAPI Key (Opcional - para rotación de IPs residenciales y anti-bloqueos)
SCRAPER_API_KEY=tu_scraper_api_key_opcional
